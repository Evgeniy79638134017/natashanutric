---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import CTA from '../../components/sections/CTA.astro';
import SideWaves from '../../components/SideWaves.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, tags, category, author } = entry.data;

const allPosts = await getCollection('blog');
const otherPosts = allPosts
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('ru-RU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(d);
}

const canonicalUrl = new URL(`/blog/${entry.id}`, Astro.site || 'https://example.com');
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: {
    '@type': 'Person',
    name: author || 'Наталья Ерёменко',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Наталья Ерёменко — нутрициолог',
  },
  url: canonicalUrl.href,
});
---

<BaseLayout title={`${title} — Блог Натальи Ерёменко`} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <Header />
  <main>
    <!-- Breadcrumbs -->
    <div style="background: var(--gradient-alt);">
      <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-sm text-text-light" aria-label="Хлебные крошки">
          <a href="/" class="shrink-0 transition-colors hover:text-primary-dark">Главная</a>
          <span class="shrink-0">/</span>
          <a href="/blog" class="shrink-0 transition-colors hover:text-primary-dark">Блог</a>
          <span class="shrink-0">/</span>
          <span class="truncate text-text">{title}</span>
        </nav>
      </div>
    </div>

    <section class="relative bg-white py-12 md:py-16 overflow-hidden">
      <SideWaves />
      <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex items-center gap-3">
          <time class="text-sm text-text-light" datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
          {category && (
            <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary-dark">
              {category}
            </span>
          )}
        </div>

        <h1 class="mt-2 font-display text-3xl font-bold text-primary-dark md:text-5xl">
          {title}
        </h1>

        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <span class="rounded-full bg-badge-bg px-3 py-1 text-xs font-medium text-badge-text">
              {tag}
            </span>
          ))}
        </div>

        <div class="prose mt-8 max-w-none prose-headings:font-display prose-headings:text-primary-dark prose-a:text-primary md:prose-lg">
          <Content />
        </div>
      </article>
    </section>

    {otherPosts.length > 0 && (
      <section class="bg-white py-12 md:py-16 border-t border-gray-100">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
          <h2 class="font-display text-xl font-bold text-primary-dark md:text-2xl">
            Читайте также
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {otherPosts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group rounded-2xl bg-white p-5 shadow-[0_4px_20px_rgba(0,0,0,0.06)] transition-shadow hover:shadow-lg"
              >
                <time class="text-xs text-text-light" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <h3 class="mt-1.5 font-display text-base font-semibold text-primary-dark transition-colors group-hover:text-primary md:text-lg">
                  {post.data.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-text-light line-clamp-2">
                  {post.data.description}
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <CTA />
  </main>
  <Footer />
</BaseLayout>
