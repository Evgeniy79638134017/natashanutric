---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import CTA from '../../components/sections/CTA.astro';
import SideWaves from '../../components/SideWaves.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, tags } = entry.data;

function formatDate(d: Date): string {
  return new Intl.DateTimeFormat('ru-RU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(d);
}
---

<BaseLayout title={`${title} — Блог Натальи Ерёменко`} description={description}>
  <Header />
  <main>
    <!-- Breadcrumbs -->
    <div style="background: var(--gradient-alt);">
      <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
        <nav class="flex items-center gap-2 text-sm text-text-light" aria-label="Хлебные крошки">
          <a href="/" class="shrink-0 transition-colors hover:text-primary-dark">Главная</a>
          <span class="shrink-0">/</span>
          <a href="/blog" class="shrink-0 transition-colors hover:text-primary-dark">Блог</a>
          <span class="shrink-0">/</span>
          <span class="truncate text-text">{title}</span>
        </nav>
      </div>
    </div>

    <section class="relative bg-white py-12 md:py-16 overflow-hidden">
      <SideWaves />
      <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 relative z-10">
        <time class="text-sm text-text-light" datetime={date.toISOString()}>
          {formatDate(date)}
        </time>

        <h1 class="mt-2 font-display text-3xl font-bold text-primary-dark md:text-5xl">
          {title}
        </h1>

        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <span class="rounded-full bg-badge-bg px-3 py-1 text-xs font-medium text-badge-text">
              {tag}
            </span>
          ))}
        </div>

        <div class="prose mt-8 max-w-none prose-headings:font-display prose-headings:text-primary-dark prose-a:text-primary md:prose-lg">
          <Content />
        </div>
      </article>
    </section>

    <CTA />
  </main>
  <Footer />
</BaseLayout>
