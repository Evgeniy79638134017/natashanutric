---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Specializations from '../components/sections/Specializations.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import CasesPreview from '../components/sections/CasesPreview.astro';
import Myths from '../components/sections/Myths.astro';
import CTA from '../components/sections/CTA.astro';
---

<PageLayout title="Наталья Ерёменко — нутрициолог в Благовещенске" description="Комплексные программы восстановления здоровья на основе клеточного питания. Нутрициолог-биохакер Наталья Ерёменко, Благовещенск.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Наталья Ерёменко — нутрициолог",
          "url": "https://example.com",
          "description": "Комплексные программы восстановления здоровья на основе клеточного питания",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Благовещенск",
            "addressRegion": "Амурская область",
            "addressCountry": "RU"
          },
          "sameAs": [
            "https://wa.me/79638134017",
            "https://t.me/natashanutric",
            "https://instagram.com/natashanutric"
          ]
        },
        {
          "@type": "WebSite",
          "name": "Наталья Ерёменко — нутрициолог",
          "url": "https://example.com"
        }
      ]
    })} />
  </Fragment>
  <Hero />
  <Specializations />
  <HowItWorks />
  <CasesPreview />
  <Myths />
  <CTA />
</PageLayout>
