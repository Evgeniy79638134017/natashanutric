---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProgramFilter from '../../components/programs/ProgramFilter';

const allPrograms = await getCollection('programs');
const sorted = allPrograms.sort((a, b) => a.data.order - b.data.order);

const programsData = sorted.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  duration: p.data.duration,
  price: p.data.price,
}));
---

<PageLayout title="Программы здоровья — Наталья Ерёменко" description="Индивидуальные программы питания и здоровья от 30 до 180 дней с полным сопровождением.">
  <section class="bg-white/60 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-[Montserrat] text-3xl font-bold text-primary-dark md:text-5xl">
        Программы здоровья
      </h1>
      <p class="mt-3 text-base text-text-light md:text-lg">
        Индивидуальные программы на 30–180 дней с сопровождением
      </p>

      <div class="mt-10">
        <ProgramFilter programs={programsData} client:load />
      </div>
    </div>
  </section>

  <!-- Help section -->
  <section style="background: linear-gradient(180deg, #FFF8F2 0%, #FFF0F0 100%);" class="py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-[Montserrat] text-2xl font-bold text-primary-dark md:text-4xl">
        Не знаете какую программу выбрать?
      </h2>
      <p class="mt-4 text-base text-text-light md:text-lg">
        Запишитесь на бесплатную консультацию — вместе разберёмся в вашей ситуации
        и подберём подходящую программу
      </p>
      <a
        href="/consultation"
        class="mt-8 inline-block rounded-full px-8 py-3.5 text-base font-semibold text-white transition-colors md:text-lg"
        style="background: linear-gradient(135deg, #7CB59D, #5EA882); box-shadow: 0 6px 20px rgba(124,181,157,0.27);"
      >
        Бесплатная консультация
      </a>
    </div>
  </section>
</PageLayout>
