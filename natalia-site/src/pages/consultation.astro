---
import PageLayout from '../layouts/PageLayout.astro';
import ConsultationForm from '../components/forms/ConsultationForm';

const tariffs = [
  {
    name: 'Знакомство',
    price: 'Бесплатно',
    duration: '15 минут',
    features: ['Знакомство', 'Выявление потребностей', 'Ответы на вопросы'],
    badge: null,
    highlighted: false,
  },
  {
    name: 'Подробная консультация',
    price: '2 000 ₽',
    duration: '30–60 минут',
    features: [
      'Анализ анкеты здоровья',
      'Детальный разбор ситуации',
      'Персональные рекомендации',
    ],
    badge: 'Популярный',
    highlighted: true,
  },
  {
    name: 'Программа здоровья',
    price: '5 000 ₽',
    duration: 'До 6 месяцев',
    features: [
      'Консультация 60 мин',
      'Индивидуальная программа',
      'Подбор комплексов Agenyz',
      'Сопровождение на всём пути',
    ],
    badge: 'Максимум',
    highlighted: false,
    note: 'При покупке GET Plus Agenyz — бесплатно',
  },
];

const faq = [
  {
    question: 'Как проходит консультация?',
    answer:
      'Сначала знакомство 15 минут — бесплатно. Затем вы заполняете подробную анкету здоровья. После этого мы проводим детальный разбор вашей ситуации и составляем индивидуальную программу.',
  },
  {
    question: 'Можно онлайн?',
    answer:
      'Да, я работаю онлайн по всей России и за рубежом. Консультации проходят в удобном для вас мессенджере — WhatsApp, Telegram или Zoom.',
  },
  {
    question: 'Как быстро будет результат?',
    answer:
      'Первые изменения заметны уже через 1–2 недели. Устойчивый результат формируется через 2–3 месяца системной работы.',
  },
  {
    question: 'Нужно сдавать анализы?',
    answer:
      'Желательно, но не обязательно. Работаем с тем, что есть. Если нужны дополнительные данные, я подскажу, какие анализы сдать.',
  },
];
---

<PageLayout title="Записаться на консультацию — нутрициолог Наталья Ерёменко" description="Запишитесь на бесплатную консультацию нутрициолога Натальи Ерёменко. Тарифы, форма записи, ответы на вопросы.">

  <!-- Tariffs -->
  <section class="bg-white/60 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-center font-[Montserrat] text-3xl font-bold text-primary-dark md:text-5xl">
        Запись на консультацию
      </h1>
      <p class="mt-3 text-center text-base text-text-light md:text-lg">
        Выберите подходящий формат работы
      </p>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {tariffs.map(({ name, price, duration, features, badge, highlighted, note }) => (
          <div
            class:list={[
              'relative flex flex-col rounded-2xl p-6 transition-shadow',
              highlighted
                ? 'bg-card shadow-xl ring-2 ring-primary'
                : 'bg-card shadow-md',
            ]}
          >
            {badge && (
              <span class:list={[
                'absolute -top-3 right-6 rounded-full px-4 py-1 text-xs font-semibold',
                highlighted ? 'text-white' : 'text-primary-dark',
              ]} style={highlighted ? 'background: linear-gradient(135deg, #7CB59D, #5EA882);' : 'background: #F4A7B4;'}>
                {badge}
              </span>
            )}

            <h3 class="font-[Montserrat] text-lg font-semibold text-primary-dark md:text-xl">
              {name}
            </h3>

            <p class="mt-2 font-[Montserrat] text-2xl font-bold text-primary-dark md:text-3xl">
              {price}
            </p>

            <p class="mt-1 text-sm text-text-light md:text-base">{duration}</p>

            <ul class="mt-5 flex flex-1 flex-col gap-2">
              {features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-text-light md:text-base">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-badge-bg text-xs text-primary-dark">✓</span>
                  {f}
                </li>
              ))}
            </ul>

            {note && (
              <p class="mt-4 rounded-lg bg-accent/15 px-3 py-2 text-xs text-primary-dark md:text-sm">
                {note}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section style="background: linear-gradient(180deg, #FFF8F2 0%, #FFF0F0 100%);" class="py-16 md:py-24">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <ConsultationForm client:load />
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white/60 py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center font-[Montserrat] text-2xl font-bold text-primary-dark md:text-4xl">
        Частые вопросы
      </h2>

      <div class="mt-10 flex flex-col gap-4">
        {faq.map(({ question, answer }) => (
          <details class="group rounded-2xl bg-card shadow-md">
            <summary class="flex cursor-pointer items-center gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden list-none">
              <span class="h-full w-1 shrink-0 self-stretch rounded-full bg-primary"></span>
              <span class="flex-1 font-[Montserrat] text-base font-semibold text-primary-dark md:text-lg">
                {question}
              </span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary transition-transform group-open:rotate-45">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-5 pl-11">
              <p class="text-sm leading-relaxed text-text-light md:text-base">{answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
