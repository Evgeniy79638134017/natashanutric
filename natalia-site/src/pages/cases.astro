---
import PageLayout from '../layouts/PageLayout.astro';
import CTA from '../components/sections/CTA.astro';
import { cases } from '../data/cases';
import SideWaves from '../components/SideWaves.astro';
---

<PageLayout title="Результаты клиентов — нутрициолог Наталья Ерёменко" description="Реальные истории людей, которые изменили своё здоровье с помощью нутрициолога Натальи Ерёменко.">
  <section class="bg-white py-16 md:py-24 relative overflow-hidden">
    <SideWaves />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="font-display text-3xl font-bold text-primary-dark md:text-5xl">
        Результаты клиентов
      </h1>
      <p class="mt-3 text-lg text-text md:text-xl">
        Реальные истории людей, которые изменили здоровье
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
        {cases.map(({ title, who, problem, process, result, duration }) => (
          <div class="rounded-2xl bg-white p-6 shadow-md md:p-8">
            <!-- Header -->
            <div class="flex items-start justify-between gap-4">
              <h2 class="font-display text-xl font-bold text-primary-dark md:text-2xl">
                {title}
              </h2>
              <span class="shrink-0 rounded-full bg-bg-alt px-3 py-1 text-xs font-medium text-text-light">
                {duration}
              </span>
            </div>

            <span class="mt-2 inline-block rounded-full bg-badge-bg px-3 py-1 text-xs font-medium text-badge-text">
              {who}
            </span>

            <!-- Problem -->
            <div class="mt-5 rounded-xl bg-bg-alt p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-text-light">Проблема</p>
              <p class="mt-1 text-sm leading-relaxed text-text md:text-base">{problem}</p>
            </div>

            <!-- Process -->
            <div class="mt-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-text-light">Что делали</p>
              <p class="mt-1 text-base leading-relaxed text-text-light md:text-lg">{process}</p>
            </div>

            <!-- Result -->
            <div class="mt-3 rounded-xl bg-badge-bg p-4">
              <p class="text-xs font-semibold uppercase tracking-wider text-primary-dark">Результат</p>
              <p class="mt-1 text-sm font-medium leading-relaxed text-primary-dark md:text-base">{result}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</PageLayout>
