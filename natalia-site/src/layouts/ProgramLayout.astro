---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  duration: string;
  price: string;
  priceNote?: string;
  forWhom: string[];
  includes: string[];
  products: string[];
  results: string[];
}

const {
  title,
  description,
  duration,
  price,
  priceNote,
  forWhom,
  includes: programIncludes,
  products,
  results,
} = Astro.props;
---

<BaseLayout title={`${title} — Наталья Еременко`} description={description}>
  <Header />
  <main>
    <!-- Breadcrumbs -->
    <div class="bg-bg-alt">
      <div class="mx-auto max-w-7xl px-4 py-3 lg:px-8">
        <nav class="flex items-center gap-2 text-sm text-text-light" aria-label="Хлебные крошки">
          <a href="/" class="transition-colors hover:text-primary">Главная</a>
          <span>/</span>
          <a href="/programs" class="transition-colors hover:text-primary">Программы</a>
          <span>/</span>
          <span class="text-text">{title}</span>
        </nav>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-10 md:py-16 lg:px-8">
      <div class="lg:grid lg:grid-cols-3 lg:gap-12">
        <!-- Main content -->
        <div class="lg:col-span-2">
          <h1 class="font-[Montserrat] text-3xl font-bold text-primary-dark md:text-4xl">
            {title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-text-light">
            {description}
          </p>

          <!-- MDX content -->
          <div class="prose mt-8 max-w-none text-text-light">
            <slot />
          </div>

          <!-- For whom -->
          <section class="mt-10">
            <h2 class="font-[Montserrat] text-2xl font-bold text-primary-dark">
              Для кого подходит
            </h2>
            <ul class="mt-4 flex flex-col gap-3">
              {forWhom.map((item) => (
                <li class="flex items-start gap-3 text-text-light">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-light/20 text-xs text-primary">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </section>

          <!-- Includes -->
          <section class="mt-10">
            <h2 class="font-[Montserrat] text-2xl font-bold text-primary-dark">
              Что включает
            </h2>
            <ul class="mt-4 flex flex-col gap-3">
              {programIncludes.map((item) => (
                <li class="flex items-start gap-3 text-text-light">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-light/20 text-xs text-primary">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </section>

          <!-- Products -->
          <section class="mt-10">
            <h2 class="font-[Montserrat] text-2xl font-bold text-primary-dark">
              Продукты Genes
            </h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {products.map((product) => (
                <span class="rounded-full bg-accent/20 px-4 py-1.5 text-sm font-medium text-primary-dark">
                  {product}
                </span>
              ))}
            </div>
          </section>

          <!-- Results -->
          <section class="mt-10">
            <h2 class="font-[Montserrat] text-2xl font-bold text-primary-dark">
              Ожидаемые результаты
            </h2>
            <ul class="mt-4 flex flex-col gap-3">
              {results.map((item) => (
                <li class="flex items-start gap-3 text-text-light">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/30 text-xs text-primary-dark">★</span>
                  {item}
                </li>
              ))}
            </ul>
          </section>
        </div>

        <!-- Sidebar -->
        <aside class="mt-10 lg:mt-0">
          <div class="sticky top-20 rounded-2xl bg-white p-6 shadow-lg">
            <p class="text-sm font-medium text-text-light">Длительность</p>
            <p class="mt-1 font-[Montserrat] text-lg font-semibold text-primary-dark">
              {duration}
            </p>

            <div class="mt-5 border-t border-bg-alt pt-5">
              <p class="text-sm font-medium text-text-light">Стоимость</p>
              <p class="mt-1 font-[Montserrat] text-3xl font-bold text-primary">
                {price}
              </p>
              {priceNote && (
                <p class="mt-1 text-sm text-text-light">{priceNote}</p>
              )}
            </div>

            <a
              href="/consultation"
              class="mt-6 block w-full rounded-full bg-primary py-3.5 text-center text-base font-semibold text-white transition-colors hover:bg-primary-dark"
            >
              Записаться на консультацию
            </a>

            <p class="mt-3 text-center text-xs text-text-light">
              Первая консультация — бесплатно
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
