---
const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/about', label: 'Обо мне' },
  { href: '/programs', label: 'Программы' },
  { href: '/cases', label: 'Кейсы' },
  { href: '/blog', label: 'Блог' },
  { href: '/contacts', label: 'Контакты' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-[110] transition-shadow duration-300"
  style="background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex flex-col leading-tight">
      <span class="font-[Montserrat] text-lg font-bold text-primary-dark">
        Наталья Ерёменко
      </span>
      <span class="text-xs text-text-light">нутрициолог-биохакер</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Основная навигация">
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors md:text-base',
              isActive
                ? 'bg-primary/10 text-primary-dark'
                : 'text-text hover:bg-primary/5 hover:text-primary-dark',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA + Mobile burger -->
    <div class="flex items-center gap-3">
      <a
        href="/consultation"
        class="hidden rounded-full px-6 py-2.5 text-sm font-semibold text-white transition-colors lg:inline-block"
        style="background: linear-gradient(135deg, #7CB59D, #5EA882); box-shadow: 0 6px 20px rgba(124,181,157,0.27);"
      >
        Записаться
      </a>

      <!-- Burger button -->
      <button
        id="burger-btn"
        type="button"
        class="relative z-[120] flex h-10 w-10 items-center justify-center rounded-lg lg:hidden"
        aria-label="Открыть меню"
        aria-expanded="false"
      >
        <span id="burger-icon" class="flex flex-col gap-1.5">
          <span class="block h-0.5 w-6 rounded-full bg-primary-dark transition-all duration-300 origin-center"></span>
          <span class="block h-0.5 w-6 rounded-full bg-primary-dark transition-all duration-300"></span>
          <span class="block h-0.5 w-6 rounded-full bg-primary-dark transition-all duration-300 origin-center"></span>
        </span>
      </button>
    </div>
  </div>

</header>

<!-- Mobile menu overlay (outside header to avoid inheriting translucent bg) -->
<div
  id="mobile-menu"
  class="fixed left-0 right-0 bottom-0 top-[56px] z-[100] flex translate-x-full flex-col bg-white transition-transform duration-300 ease-in-out lg:hidden"
>
  <div class="flex flex-1 flex-col items-center justify-center gap-6">
    {navLinks.map(({ href, label }) => {
      const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
      return (
        <a
          href={href}
          class:list={[
            'text-2xl font-[Montserrat] font-semibold transition-colors',
            isActive ? 'text-primary-dark' : 'text-text hover:text-primary-dark',
          ]}
        >
          {label}
        </a>
      );
    })}
    <a
      href="/consultation"
      class="mt-4 rounded-full px-8 py-3 text-lg font-semibold text-white transition-colors"
      style="background: linear-gradient(135deg, #7CB59D, #5EA882);"
    >
      Записаться
    </a>
  </div>
</div>

<!-- Spacer to offset fixed header -->
<div class="h-16"></div>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const burgerBtn = document.getElementById('burger-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const burgerIcon = document.getElementById('burger-icon');

    if (!header || !burgerBtn || !mobileMenu || !burgerIcon) return;

    let isOpen = false;
    const lines = burgerIcon.querySelectorAll('span');

    function toggleMenu() {
      isOpen = !isOpen;
      burgerBtn.setAttribute('aria-expanded', String(isOpen));

      if (isOpen) {
        mobileMenu.classList.remove('translate-x-full');
        mobileMenu.classList.add('translate-x-0');
        document.body.style.overflow = 'hidden';
        lines[0].classList.add('rotate-45', 'translate-y-[4px]');
        lines[1].classList.add('opacity-0');
        lines[2].classList.add('-rotate-45', '-translate-y-[4px]');
      } else {
        mobileMenu.classList.add('translate-x-full');
        mobileMenu.classList.remove('translate-x-0');
        document.body.style.overflow = '';
        lines[0].classList.remove('rotate-45', 'translate-y-[4px]');
        lines[1].classList.remove('opacity-0');
        lines[2].classList.remove('-rotate-45', '-translate-y-[4px]');
      }
    }

    burgerBtn.addEventListener('click', toggleMenu);

    // Shadow on scroll
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 10) {
            header.classList.add('shadow-md');
          } else {
            header.classList.remove('shadow-md');
          }
          ticking = false;
        });
        ticking = true;
      }
    });
  }

  // Run on initial load and on Astro view transitions
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
