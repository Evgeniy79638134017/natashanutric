---
interface Props {
  flip?: boolean;
  color?: string;
}
const { flip = false, color = '#FFFFFF' } = Astro.props;
---
<div class="w-full overflow-hidden leading-none" style={flip ? 'transform: rotate(180deg)' : ''}>
  <svg
    class="w-full h-auto block"
    viewBox="0 0 1440 60"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M0,30 C240,50 480,0 720,30 C960,60 1200,10 1440,30 L1440,60 L0,60 Z"
      fill={color}
    />
  </svg>
</div>
