---
const cards = [
  {
    emoji: '🔥',
    title: 'Похудение',
    description: 'Снижение веса без изнуряющих диет и подсчёта калорий',
  },
  {
    emoji: '⚡',
    title: 'Энергия',
    description: 'Избавление от хронической усталости и восстановление сил',
  },
  {
    emoji: '🧘',
    title: 'Антистресс',
    description: 'Снятие стресса и тревожности. Восстановление сна',
  },
  {
    emoji: '🛡️',
    title: 'Иммунитет',
    description: 'Укрепление иммунной системы',
  },
];
---

<section id="specializations" class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-display text-2xl font-bold text-primary-dark md:text-4xl">
      Чем я могу помочь
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map(({ emoji, title, description }) => (
        <div class="rounded-2xl bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.06)] transition-shadow hover:shadow-lg">
          <span class="text-4xl">{emoji}</span>
          <h3 class="mt-4 font-display text-lg font-semibold text-primary-dark md:text-xl">
            {title}
          </h3>
          <p class="mt-2 text-base leading-relaxed text-text-light md:text-lg">
            {description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
