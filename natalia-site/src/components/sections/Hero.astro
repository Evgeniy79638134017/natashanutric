---
---

<section class="relative overflow-hidden bg-gradient-to-b from-bg to-bg-alt">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 md:py-24 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-32">
    <!-- Text -->
    <div class="flex flex-col items-start">
      <h1 class="font-[Montserrat] text-3xl font-bold leading-tight text-primary-dark md:text-5xl lg:text-6xl">
        Верните здоровье и&nbsp;энергию без диет и&nbsp;стресса
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-text-light">
        Нутрициолог-биохакер Наталья Еременко. Комплексные программы
        восстановления здоровья на&nbsp;основе клеточного питания
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/consultation"
          class="rounded-full bg-primary px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          Бесплатная консультация
        </a>
        <a
          href="#specializations"
          class="rounded-full border-2 border-primary px-7 py-3.5 text-base font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
        >
          Узнать больше
        </a>
      </div>
    </div>

    <!-- Photo placeholder -->
    <div class="flex justify-center lg:justify-end">
      <div class="flex h-[400px] w-full max-w-[400px] items-center justify-center rounded-3xl bg-bg-alt text-text-light shadow-lg md:h-[500px]" role="img" aria-label="Фото нутрициолога Натальи Еременко">
        <span class="text-lg">Фото Натальи</span>
      </div>
    </div>
  </div>
</section>
