---
---

<section class="relative overflow-hidden" style="background: linear-gradient(135deg, #FDECD0 0%, #FBE4E0 40%, #FCE4EC 100%);">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-32">
    <!-- Text -->
    <div class="flex flex-col items-start">
      <h1 class="font-[Montserrat] text-3xl font-bold leading-tight text-primary-dark md:text-5xl lg:text-6xl">
        Верните здоровье и&nbsp;энергию без диет и&nbsp;стресса
      </h1>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-text md:text-lg">
        Нутрициолог-биохакер Наталья Ерёменко. Комплексные программы
        восстановления здоровья на&nbsp;основе клеточного питания
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/consultation"
          class="rounded-full px-7 py-3.5 text-base font-semibold text-white transition-colors md:text-lg md:px-8 md:py-4"
          style="background: linear-gradient(135deg, #7CB59D, #5EA882); box-shadow: 0 6px 20px rgba(124,181,157,0.27);"
        >
          Бесплатная консультация
        </a>
        <a
          href="#specializations"
          class="rounded-full border-2 border-primary-dark/20 px-7 py-3.5 text-base font-semibold text-primary-dark transition-colors hover:bg-primary-dark hover:text-white md:text-lg md:px-8 md:py-4"
        >
          Узнать больше
        </a>
      </div>
    </div>

    <!-- Photo -->
    <div class="flex justify-center lg:justify-end">
      <img
        src="/images/hero/photo_2026-02-04_16-43-28.jpg"
        alt="Нутрициолог Наталья Ерёменко"
        class="h-[400px] w-full max-w-[400px] rounded-3xl object-cover shadow-lg md:h-[500px]"
        loading="eager"
      />
    </div>
  </div>
</section>
