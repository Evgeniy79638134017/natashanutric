---
const cases = [
  {
    result: '−14 кг за 3 месяца',
    person: 'Мужчина, 45 лет',
    description: 'Программа коррекции веса',
  },
  {
    result: 'Ушла от антидепрессантов',
    person: 'Девушка, 36 лет',
    description: 'Восстановление после панических атак',
  },
  {
    result: 'Сахар снизился',
    person: 'Женщина, 92 года',
    description: 'Уменьшение дозировки лекарств',
  },
];
---

<section class="bg-white py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-display text-2xl font-bold text-primary-dark md:text-4xl">
      Результаты клиентов
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {cases.map(({ result, person, description }) => (
        <div class="rounded-2xl bg-white p-6 shadow-[0_4px_20px_rgba(0,0,0,0.06)] transition-shadow hover:shadow-lg">
          <p class="font-display text-xl font-bold text-primary-dark md:text-2xl">
            {result}
          </p>
          <p class="mt-3 text-sm font-semibold text-text md:text-base">
            {person}
          </p>
          <p class="mt-1 text-base leading-relaxed text-text-light md:text-lg">
            {description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/cases"
        class="inline-block rounded-full border-2 border-primary px-7 py-2.5 text-base font-semibold text-primary transition-all duration-300 hover:bg-primary hover:text-white md:text-lg"
      >
        Все кейсы →
      </a>
    </div>
  </div>
</section>
