---
const cases = [
  {
    result: '−14 кг за 3 месяца',
    person: 'Мужчина, 45 лет',
    description: 'Программа коррекции веса',
  },
  {
    result: 'Ушла от антидепрессантов',
    person: 'Девушка, 36 лет',
    description: 'Восстановление после панических атак',
  },
  {
    result: 'Сахар снизился',
    person: 'Женщина, 92 года',
    description: 'Уменьшение дозировки лекарств',
  },
];
---

<section class="bg-white/60 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center font-[Montserrat] text-2xl font-bold text-primary-dark md:text-4xl">
      Результаты клиентов
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {cases.map(({ result, person, description }) => (
        <div class="rounded-2xl bg-card p-6 shadow-md transition-shadow hover:shadow-lg">
          <p class="font-[Montserrat] text-xl font-bold text-primary-dark md:text-2xl">
            {result}
          </p>
          <p class="mt-3 text-sm font-semibold text-text md:text-base">
            {person}
          </p>
          <p class="mt-1 text-sm leading-relaxed text-text-light md:text-base">
            {description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/cases"
        class="inline-block rounded-full border-2 border-primary-dark/20 px-7 py-3 text-base font-semibold text-primary-dark transition-colors hover:bg-primary-dark hover:text-white md:text-lg"
      >
        Все кейсы →
      </a>
    </div>
  </div>
</section>
