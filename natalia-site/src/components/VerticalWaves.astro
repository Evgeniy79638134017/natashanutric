<div class="vertical-waves">
  <!-- Левая волна -->
  <svg
    class="wave-left"
    viewBox="0 0 100 800"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M100,0 Q60,100 100,200 Q40,300 100,400 Q60,500 100,600 Q40,700 100,800 L0,800 L0,0 Z"
      fill="rgba(244,180,180,0.35)"
    />
    <path
      d="M80,0 Q40,100 80,200 Q20,300 80,400 Q40,500 80,600 Q20,700 80,800 L0,800 L0,0 Z"
      fill="rgba(253,210,170,0.30)"
    />
  </svg>

  <!-- Правая волна -->
  <svg
    class="wave-right"
    viewBox="0 0 100 800"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M0,0 Q40,100 0,200 Q60,300 0,400 Q40,500 0,600 Q60,700 0,800 L100,800 L100,0 Z"
      fill="rgba(244,180,180,0.35)"
    />
    <path
      d="M20,0 Q60,100 20,200 Q80,300 20,400 Q60,500 20,600 Q80,700 20,800 L100,800 L100,0 Z"
      fill="rgba(253,210,170,0.30)"
    />
  </svg>
</div>

<style>
  .vertical-waves {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 30;
    overflow: hidden;
  }

  .wave-left,
  .wave-right {
    position: absolute;
    top: 0;
    height: 100%;
    width: 120px;
  }

  .wave-left {
    left: 0;
  }

  .wave-right {
    right: 0;
  }

  @media (max-width: 1024px) {
    .vertical-waves {
      display: none;
    }
  }
</style>
