---
<!-- Левая волна — цвета из hero-градиента (#FDECD0, #FBE4E0) -->
<div class="side-wave side-wave-left" aria-hidden="true">
  <svg viewBox="0 0 60 800" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%;height:100%;">
    <path d="M0,0 C40,50 10,100 50,160 C60,220 15,300 50,380 C60,460 20,540 45,620 C55,700 15,770 0,800 L0,0 Z" fill="#FDECD0"/>
    <path d="M0,0 C35,70 5,140 45,210 C55,280 10,380 45,480 C55,580 15,680 0,800 L0,0 Z" fill="#FBE4E0" fill-opacity="0.7"/>
  </svg>
</div>

<!-- Правая волна — зеркальная, те же цвета -->
<div class="side-wave side-wave-right" aria-hidden="true">
  <svg viewBox="0 0 60 800" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%;height:100%;">
    <path d="M60,0 C20,50 50,100 10,160 C0,220 45,300 10,380 C0,460 40,540 15,620 C5,700 45,770 60,800 L60,0 Z" fill="#FDECD0"/>
    <path d="M60,0 C25,70 55,140 15,210 C5,280 50,380 15,480 C5,580 45,680 60,800 L60,0 Z" fill="#FBE4E0" fill-opacity="0.7"/>
  </svg>
</div>

<style>
  .side-wave {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .side-wave-left {
    left: 0;
  }

  .side-wave-right {
    right: 0;
  }

  /* Показывать только на широких экранах */
  @media (min-width: 1280px) {
    .side-wave {
      display: block;
    }
  }
</style>
