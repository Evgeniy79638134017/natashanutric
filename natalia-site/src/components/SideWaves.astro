<!-- Левая волна — плавные кубические кривые Безье -->
<div class="side-wave side-wave-left" aria-hidden="true">
  <svg viewBox="0 0 60 800" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%;height:100%;">
    <path d="M0,0 C25,100 5,200 30,300 C55,400 10,500 35,600 C60,700 20,750 0,800 L0,0 Z" fill="#F8C8C0"/>
    <path d="M0,0 C15,150 -5,300 20,450 C45,600 5,700 0,800 L0,0 Z" fill="#FDDCC0" fill-opacity="0.6"/>
  </svg>
</div>

<!-- Правая волна — зеркальная -->
<div class="side-wave side-wave-right" aria-hidden="true">
  <svg viewBox="0 0 60 800" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%;height:100%;">
    <path d="M60,0 C35,100 55,200 30,300 C5,400 50,500 25,600 C0,700 40,750 60,800 L60,0 Z" fill="#F8C8C0"/>
    <path d="M60,0 C45,150 65,300 40,450 C15,600 55,700 60,800 L60,0 Z" fill="#FDDCC0" fill-opacity="0.6"/>
  </svg>
</div>

<style>
  .side-wave {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .side-wave-left {
    left: 0;
  }

  .side-wave-right {
    right: 0;
  }

  /* Показывать только на широких экранах */
  @media (min-width: 1280px) {
    .side-wave {
      display: block;
    }
  }
</style>
